{
  "version": 1,
  "author": "Water Tank Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 10, "left": 100, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -30, "left": 380, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-ds18b20", "id": "temperature", "top": 160, "left": 395, "attrs": { "temperature": "25" } },
    { "type": "wokwi-resistor", "id": "pullup", "top": 260, "left": 360, "attrs": { "value": "4700" } },
    { "type": "wokwi-slide-potentiometer", "id": "turbidity", "top": -30, "left": -220, "attrs": { "value": "100", "travelLength": "30" } },
    { "type": "wokwi-slide-potentiometer", "id": "ph", "top": 110, "left": -220, "attrs": { "value": "512", "travelLength": "30" } },
    { "type": "wokwi-slide-potentiometer", "id": "ec", "top": 250, "left": -220, "attrs": { "value": "256", "travelLength": "30" } },
    { "type": "wokwi-pushbutton", "id": "failure", "top": 350, "left": 160, "attrs": { "color": "red", "bounce": "0" } },
    { "type": "wokwi-text", "id": "title", "top": -140, "left": -220, "attrs": { "text": "WATER TANK MONITOR | SIMULACAO", "fontSize": "24" } },
    { "type": "wokwi-text", "id": "subtitle", "top": -95, "left": -220, "attrs": { "text": "Arraste os controles. Clique no DS18B20 para mudar a temperatura." } },
    { "type": "wokwi-text", "id": "labelTurb", "top": -60, "left": -220, "attrs": { "text": "TURBIDEZ RELATIVA | 0-100% (simulada)" } },
    { "type": "wokwi-text", "id": "labelPh", "top": 80, "left": -220, "attrs": { "text": "pH | 0-14 (simulado)" } },
    { "type": "wokwi-text", "id": "labelEc", "top": 220, "left": -220, "attrs": { "text": "EC | 0-2000 uS/cm (simulada)" } },
    { "type": "wokwi-text", "id": "labelTemp", "top": 120, "left": 360, "attrs": { "text": "TEMPERATURA | DS18B20" } },
    { "type": "wokwi-text", "id": "labelFailure", "top": 420, "left": 65, "attrs": { "text": "Segure: simular falha de medicao" } },
    { "type": "wokwi-text", "id": "notice", "top": 480, "left": -220, "attrs": { "text": "Dados sinteticos. Nao usar este diagrama como esquema de montagem dos sensores reais." } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "oled:VCC", "red", [ "h70", "v-100" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "h90", "v-120" ] ],
    [ "esp:D21", "oled:SDA", "green", [ "h45", "v-60" ] ],
    [ "esp:D22", "oled:SCL", "blue", [ "h55", "v-80" ] ],
    [ "esp:3V3", "temperature:VCC", "red", [ "h80", "v110" ] ],
    [ "esp:GND.1", "temperature:GND", "black", [ "h100", "v130" ] ],
    [ "esp:D4", "temperature:DQ", "purple", [ "h30" ] ],
    [ "temperature:DQ", "pullup:1", "purple", [] ],
    [ "pullup:2", "esp:3V3", "red", [ "v40" ] ],
    [ "esp:3V3", "turbidity:VCC", "red", [ "h25", "v-170", "h-420" ] ],
    [ "esp:GND.2", "turbidity:GND", "black", [ "h-70", "v-80" ] ],
    [ "turbidity:SIG", "esp:D34", "orange", [ "h140" ] ],
    [ "turbidity:VCC", "ph:VCC", "red", [ "h-30" ] ],
    [ "turbidity:GND", "ph:GND", "black", [ "h-50" ] ],
    [ "ph:SIG", "esp:D35", "green", [ "h120" ] ],
    [ "ph:VCC", "ec:VCC", "red", [ "h-30" ] ],
    [ "ph:GND", "ec:GND", "black", [ "h-50" ] ],
    [ "ec:SIG", "esp:D32", "blue", [ "h100" ] ],
    [ "failure:1.l", "esp:D27", "purple", [ "h-60", "v-140" ] ],
    [ "failure:2.l", "esp:GND.2", "black", [ "v30", "h-160" ] ]
  ],
  "serialMonitor": { "display": "always", "newline": "lf", "convertEol": true }
}
